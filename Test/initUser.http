Content-Type: application/json

{
  "username": "master",
  "password": "Abcd1234!",
  "slackId": "010-2234-5678",
  "role": "ROLE_MASTER",
  "hubId": "afd3c207-c492-4f96-b53a-60ef17f5a879"
}

